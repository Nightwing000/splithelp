# Copy to .env and fill in. Never commit .env.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional model overrides; defaults are gemini-flash-latest and
# gemini-flash-lite-latest.
GEMINI_PRIMARY_MODEL=
GEMINI_FALLBACK_MODEL=

# PostgreSQL (defaults match docker-compose.yml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=splitter_user
POSTGRES_ADMIN_PASSWORD=devpassword
# Password for the SELECT-only role used by natural-language questions.
# Pick your own, then run: python scripts/setup_read_only_role.py
POSTGRES_READONLY_PASSWORD=

# Telegram bot (create one with @BotFather)
TELEGRAM_BOT_TOKEN=
# Who may use the bot: telegram_user_id:app_user_id pairs, comma-separated.
# Anyone not listed is refused. Get your Telegram id from @userinfobot.
TELEGRAM_USERS=
# The group the bot manages (printed by scripts/seed_demo.py).
SPLITHELP_GROUP_ID=
